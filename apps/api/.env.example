PORT=3000
DATABASE_URL=postgresql://postgres.rbxfogumeuuyxsvmjsxl:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# false (ค่าแนะนำ) = รัน migration อัตโนมัติตอนเริ่มแอป
# true = synchronize ตาม entity ทันที ใช้ได้เฉพาะตอนพัฒนา ห้ามใช้กับ production
DB_SYNC=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# origin ของ web ที่อนุญาต (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:5173
# อยู่หลัง reverse proxy ให้ตั้งเป็น 1 เพื่อให้ระบบกันเดารหัสผ่านเห็น IP จริงของผู้ใช้
# TRUST_PROXY=1

# ---- Phase 3: การชำระเงิน PromptPay อัตโนมัติ ----
# none (ค่าเริ่มต้น) = พนักงานกดยืนยันเองว่าได้รับเงิน
# webhook = รับแจ้งเงินเข้าจาก payment gateway ที่ POST /api/payments/webhook (ต้องตั้ง PAYMENT_WEBHOOK_SECRET)
# mock    = จำลองสำหรับพัฒนา/สาธิต (ห้ามใช้ใน production — แอปจะไม่เริ่มทำงาน)
PAYMENT_PROVIDER=none
# PAYMENT_WEBHOOK_SECRET=ตั้งเป็นสตริงสุ่มยาว (ใช้ร่วมกับผู้ให้บริการเพื่อเซ็น HMAC-SHA256)
