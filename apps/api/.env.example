PORT=3000
DATABASE_URL=postgres://pos:pos_dev_password@localhost:5432/pos
# ใช้ true เฉพาะตอนพัฒนา (สร้างตารางอัตโนมัติ) — production ให้ใช้ migration
DB_SYNC=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# origin ของ web ที่อนุญาต (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:5173
